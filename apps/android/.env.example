# Copy this file to apps/android/.env.local to override the production API URL.
# If .env.local is absent, apps/android/.env is used as a fallback.
# You can also set API_BASE_URL as an environment variable for CI builds.
# Debug builds use the emulator backend unless DEBUG_API_BASE_URL is set.
API_BASE_URL=https://your-api.onrender.com/api/v1/
