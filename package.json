{
  "name": "personal-diary-notes-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:server": "pnpm --filter @notes/server dev",
    "dev:web": "pnpm --filter @notes/web dev",
    "dev:mobile": "pnpm --filter @notes/mobile start",
    "dev:mobile:android": "pnpm --filter @notes/mobile android",
    "prebuild:mobile:android": "pnpm --filter @notes/mobile exec expo prebuild --platform android",
    "build:shared": "pnpm --filter @notes/shared build",
    "build:server": "pnpm --filter @notes/server build",
    "build:web": "pnpm build:shared && pnpm --filter @notes/web build",
    "build": "pnpm build:shared && pnpm build:server && pnpm --filter @notes/web build",
    "test:server": "pnpm --filter @notes/server test",
    "test": "pnpm test:server",
    "lint": "pnpm --filter @notes/* lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
